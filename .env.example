# Copy this file to .env and adjust values for your machine.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=2PC
DB_USER=postgres
DB_PASSWORD=postgres

# Backend
ASPNETCORE_URLS=http://0.0.0.0:5288
BANKB_BASE_URL=http://localhost:5289
BANKB_MOCK_MODE=true

# Web app
NEXT_PUBLIC_API_URL=http://localhost:5288/api

# Mobile app
# Android emulator can use http://10.0.2.2:5288/api.
# A physical phone needs your computer LAN IP, for example http://192.168.1.10:5288/api.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5288/api
